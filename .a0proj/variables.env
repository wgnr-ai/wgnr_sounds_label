# ============================================================
# LABEL IDENTITY
# ============================================================
# Canonical brand-asset base path. Files are NOT copied into
# this project — they live in the SysOp knowledge base and
# are referenced by absolute path. Adjust if the canonical
# brand-asset location ever relocates.
WGNR_SOUNDS_BRAND_ASSETS_DIR=/a0/usr/projects/wgnr_sounds_label/docs/brand-assets

# Active brand guide for WGNR Sounds (shared from wgnr.ai parent until a Sounds-specific guide exists).
WGNR_SOUNDS_ACTIVE_BRAND_GUIDE=/a0/usr/projects/wgnr_ai_sysop/.a0proj/knowledge/client-assets/wgnr-assets/wgnr-brand-guide.pdf

# ============================================================
